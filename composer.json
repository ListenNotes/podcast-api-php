{
    "name": "listennotes/podcast-api",
    "description": "PHP bindings for the Listen Notes Podcast API",
    "license": "MIT",
    "authors": [
        {
            "name": "Listen Notes, Inc.",
            "email": "hello@listennotes.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.3"
    },
    "autoload": {
        "psr-4": {
            "ListenNotes\\PodcastApi\\": "listennotes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ListenNotes\\PodcastApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite offline",
        "test-integration": "phpunit --testsuite integration",
        "lint": "@php tests/lint.php"
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.phpunit.cache",
            "/vendor",
            "/composer.phar",
            "/tests",
            "/phpunit.xml",
            "/composer.lock"
        ]
    }
}
